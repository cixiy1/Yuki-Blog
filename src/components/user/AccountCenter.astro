---
/**
 * 账号中心：登录表单 + 已登录信息，`/login/` 与 `/me/` 共用。
 *
 * mode="login"  —— 只有表单；登录后显示账号摘要与「进入个人中心」
 * mode="center" —— 表单；登录后显示账号信息 + 管理中心（仅 admin）+ 我的组织
 *
 * 登录态只能在客户端拿到（静态构建），所以两块都 SSR 出来，由 <account-center>
 * 的脚本按 /api/auth/me 的结果切换。不用 visibility:hidden 藏整卡——无 JS 时会永久空白。
 */
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

interface Props {
	mode?: "login" | "center";
}

const { mode = "login" } = Astro.props;
const isCenter = mode === "center";

const inputClass =
	"w-full px-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm";
const primaryBtnClass =
	"w-full h-10 rounded-xl bg-(--primary) text-sm font-semibold text-white dark:text-black/70 hover:opacity-90 active:opacity-80 transition-opacity duration-150 disabled:opacity-60 disabled:pointer-events-none";
const regularBtnClass =
	"btn-regular w-full h-10 rounded-xl text-sm font-medium disabled:opacity-60 disabled:pointer-events-none";
// 不能用 max-w-md / max-w-2xl：主题在 variables.styl 把 --container-md 改成了 100%，
// Tailwind v4 的 max-w-* 走这组变量，会变成不限制宽度。这里写死 rem。
const cardWidth = isCenter ? "max-w-[42rem]" : "max-w-[28rem]";
---

<account-center data-mode={mode} class="block w-full">
	<div class="flex w-full flex-col items-center rounded-(--radius-large)" data-pagefind-ignore>
		{/* 未登录 */}
		<section
			data-role="guest"
			class:list={["card-base w-full px-6 py-8 md:px-8", cardWidth]}
		>
			<div class="mb-6">
				<h2 class="text-2xl font-bold text-90">
					{isCenter ? "登录后进入个人中心" : "登录 Yuki Blog"}
				</h2>
				<p class="mt-1.5 text-sm text-50">邮箱验证码登录，首次登录自动注册。</p>
			</div>

			<form data-role="form" novalidate class="space-y-3">
				<label class="block">
					<span class="mb-1.5 block text-xs text-50">邮箱</span>
					<input
						data-role="email"
						type="email"
						name="email"
						autocomplete="email"
						inputmode="email"
						placeholder="you@example.com"
						required
						class={inputClass}
					/>
				</label>

				<button data-role="send" type="button" class={regularBtnClass}>
					发送验证码
				</button>

				<div data-role="code-block" hidden class="space-y-3">
					<label class="block">
						<span class="mb-1.5 block text-xs text-50">验证码</span>
						<input
							data-role="code"
							name="code"
							inputmode="numeric"
							autocomplete="one-time-code"
							maxlength="6"
							placeholder="6 位数字"
							class={inputClass}
						/>
					</label>
					<button type="submit" class={primaryBtnClass}>登录</button>
				</div>
			</form>

			<div class="my-5 flex items-center gap-3 text-xs text-50">
				<span class="h-px flex-1 bg-(--line-divider)"></span>
				<span>或</span>
				<span class="h-px flex-1 bg-(--line-divider)"></span>
			</div>

			<a
				data-role="github"
				href="/api/auth/github/start"
				class="flex h-10 w-full items-center justify-center gap-2 rounded-xl border border-(--line-divider) text-sm font-medium text-(--btn-content) transition-colors duration-150 hover:bg-(--btn-regular-bg)"
			>
				<Icon name="fa7-brands:github" class="text-base" />
				用 GitHub 登录
			</a>

			<p
				data-role="msg"
				role="status"
				aria-live="polite"
				class="mt-3 min-h-5 text-xs text-50"
			>
			</p>
		</section>

		{/* 已登录 */}
		<section
			data-role="logged"
			hidden
			class:list={["card-base w-full px-6 py-7 md:px-8", cardWidth]}
		>
			<div class="flex items-center gap-4">
				<div
					class="flex h-14 w-14 shrink-0 items-center justify-center overflow-hidden rounded-full bg-(--btn-regular-bg) text-xl font-semibold text-(--btn-content)"
				>
					<img data-role="avatar" alt="" class="h-full w-full object-cover" hidden />
					<span data-role="avatar-fallback"></span>
				</div>
				<div class="min-w-0">
					<h2 data-role="name" class="truncate text-xl font-bold text-90">
					</h2>
					<p class="mt-1 flex flex-wrap items-center gap-2 text-xs text-50">
						<span
							data-role="role"
							class="rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-(--btn-content)"
						></span>
						<span>uid <span data-role="uid" class="tabular-nums"></span></span>
					</p>
				</div>
			</div>

			<dl class="mt-5 divide-y divide-(--line-divider) text-sm">
				<div class="flex items-center justify-between gap-3 py-2.5">
					<dt class="shrink-0 text-50">邮箱</dt>
					<dd class="flex min-w-0 items-center gap-2 text-90">
						<span data-role="email" class="truncate"></span>
						<span
							data-role="verified"
							hidden
							class="shrink-0 rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-[11px] text-(--btn-content)"
							>已验证</span
						>
					</dd>
				</div>
				<div class="flex items-center justify-between gap-3 py-2.5">
					<dt class="shrink-0 text-50">会话有效期至</dt>
					<dd data-role="expiry" class="text-90 tabular-nums"></dd>
				</div>
			</dl>

			{
				isCenter && (
					<div class="mt-6 space-y-3">
						<div
							data-role="admin-block"
							hidden
							class="rounded-xl border border-(--line-divider) p-4"
						>
							<div class="flex items-center gap-2 text-sm font-semibold text-90">
								<Icon
									name="material-symbols:shield-person-outline"
									class="text-base text-(--primary)"
								/>
								管理中心
							</div>
							<p class="mt-1.5 text-xs text-50">审核投稿、管理用户与站点设置。</p>
							<button
								data-role="admin-open"
								type="button"
								class="btn-regular mt-3 h-9 w-full rounded-lg text-xs font-medium"
							>
								进入管理中心
							</button>
							<p class="mt-2 text-[11px] text-30">建设中，尚未上线</p>
						</div>
						<div class="rounded-xl border border-(--line-divider) p-4">
							<div class="flex items-center gap-2 text-sm font-semibold text-90">
								<Icon
									name="material-symbols:groups-outline"
									class="text-base text-(--primary)"
								/>
								我的组织
							</div>
							<p class="mt-1.5 text-xs text-50">还没有加入组织，组织功能即将上线。</p>
						</div>
					</div>
				)
			}

			<div class="mt-6 flex flex-col gap-2 sm:flex-row">
				{
					!isCenter && (
						<a
							href={url("/me/")}
							class="flex h-10 w-full items-center justify-center rounded-xl bg-(--primary) text-sm font-semibold text-white transition-opacity duration-150 hover:opacity-90 dark:text-black/70"
						>
							进入个人中心
						</a>
					)
				}
				<button data-role="logout" type="button" class={regularBtnClass}>
					退出登录
				</button>
			</div>
			<p
				data-role="me-msg"
				role="status"
				aria-live="polite"
				class="mt-3 min-h-5 text-xs text-50"
			>
			</p>
		</section>
	</div>
</account-center>

<style>
	/* 作者类里的 display 会压过 UA 的 [hidden]，这里强制回来 */
	[hidden] {
		display: none !important;
	}
	[data-role="msg"][data-state="ok"],
	[data-role="me-msg"][data-state="ok"] {
		color: var(--primary);
	}
	[data-role="msg"][data-state="error"],
	[data-role="me-msg"][data-state="error"] {
		color: var(--admonitions-color-caution);
	}
</style>

<script>
	type Role = "user" | "reviewer" | "admin";

	interface MeUser {
		uid: number;
		email: string;
		role: Role;
		display_name: string;
		avatar_url: string | null;
		email_verified: number;
	}

	interface MeResponse {
		authenticated: boolean;
		user?: MeUser;
		session?: { expires_at: string | null };
		error?: string;
		message?: string;
	}

	interface CodeResponse {
		ok?: boolean;
		expires_in?: number;
		resend_after?: number;
		debug_code?: string;
		error?: string;
		message?: string;
		retry_after?: number;
	}

	interface VerifyResponse {
		ok?: boolean;
		error?: string;
		message?: string;
		remaining?: number;
		retry_after?: number;
	}

	const ROLE_LABEL: Record<string, string> = {
		admin: "管理员",
		reviewer: "审核员",
		user: "用户",
	};

	// GitHub 回调失败时带 ?error=xxx 跳回 /login，这里翻译成人话
	const OAUTH_ERROR: Record<string, string> = {
		github_not_configured: "GitHub 登录尚未配置",
		github_denied: "已取消 GitHub 授权",
		github_state_invalid: "登录状态校验失败，请重新发起",
		github_exchange_failed: "与 GitHub 换取凭证失败，请重试",
		github_email_unverified: "GitHub 账号没有已验证的邮箱",
		state_invalid: "登录状态校验失败，请重新发起",
		account_suspended: "账号已被停用",
		login_failed: "登录失败，请重试",
	};

	class AccountCenter extends HTMLElement {
		#timer: number | null = null;

		connectedCallback(): void {
			if (this.dataset.ready === "1") return;
			this.dataset.ready = "1";
			this.#bind();
			this.#fixGithubHref();
			void this.#refresh();
			this.#showOauthError();
		}

		disconnectedCallback(): void {
			if (this.#timer !== null) {
				window.clearInterval(this.#timer);
				this.#timer = null;
			}
		}

		/** 切页时新旧 DOM 可能短暂共存，一律在元素内查 */
		#q<T extends HTMLElement>(role: string): T | null {
			return this.querySelector<T>(`[data-role="${role}"]`);
		}

		#say(role: "msg" | "me-msg", text: string, state: "" | "ok" | "error"): void {
			const el = this.#q(role);
			if (!el) return;
			el.textContent = text;
			if (state) el.dataset.state = state;
			else delete el.dataset.state;
		}

		async #call<T>(path: string, init: RequestInit = {}) {
			const res = await fetch(path, {
				credentials: "same-origin",
				...init,
			});
			let data = {} as T;
			try {
				data = (await res.json()) as T;
			} catch {
				// 非 JSON 响应（例如 5xx 的 HTML）按空对象处理
			}
			return { ok: res.ok, status: res.status, data };
		}

		#bind(): void {
			this.#q("send")?.addEventListener("click", () => void this.#send());
			this.#q("form")?.addEventListener("submit", (event) => {
				event.preventDefault();
				void this.#verify();
			});
			this.#q("logout")?.addEventListener("click", () => void this.#logout());
			this.#q("admin-open")?.addEventListener("click", () => {
				this.#say("me-msg", "管理中心正在开发中，稍后上线", "ok");
			});
		}

		/** GitHub 的 next 参数运行时补：静态页 SSR 时读不到 query */
		#fixGithubHref(): void {
			const link = this.#q<HTMLAnchorElement>("github");
			if (!link) return;
			const next = new URLSearchParams(location.search).get("next");
			// 只放行站内绝对路径；不要整体 encodeURIComponent，%2F 会被服务端判非法
			if (next && /^\/(?!\/)/.test(next)) {
				link.href = `/api/auth/github/start?next=${next}`;
			}
		}

		#showOauthError(): void {
			const error = new URLSearchParams(location.search).get("error");
			if (!error) return;
			this.#say("msg", OAUTH_ERROR[error] ?? "登录失败，请重试", "error");
			const clean = location.pathname;
			history.replaceState(null, "", clean);
		}

		#showGuest(msg = ""): void {
			const guest = this.#q("guest");
			const logged = this.#q("logged");
			if (guest) guest.hidden = false;
			if (logged) logged.hidden = true;
			if (msg) this.#say("msg", msg, "error");
		}

		#showLogged(me: MeResponse): void {
			const user = me.user;
			if (!user) return this.#showGuest();

			const guest = this.#q("guest");
			const logged = this.#q("logged");
			if (guest) guest.hidden = true;
			if (logged) logged.hidden = false;

			const name = user.display_name || user.email.split("@")[0];
			const nameEl = this.#q("name");
			if (nameEl) nameEl.textContent = name;

			const roleEl = this.#q("role");
			if (roleEl) roleEl.textContent = ROLE_LABEL[user.role] ?? user.role;

			const uidEl = this.#q("uid");
			if (uidEl) uidEl.textContent = String(user.uid);

			const emailEl = this.#q("email");
			if (emailEl) emailEl.textContent = user.email;

			const verifiedEl = this.#q("verified");
			if (verifiedEl) verifiedEl.hidden = !user.email_verified;

			const expiryEl = this.#q("expiry");
			if (expiryEl) {
				const iso = me.session?.expires_at;
				expiryEl.textContent = iso
					? new Date(iso).toLocaleString("zh-CN", { hour12: false })
					: "—";
			}

			const avatar = this.#q<HTMLImageElement>("avatar");
			const fallback = this.#q("avatar-fallback");
			if (avatar && fallback) {
				if (user.avatar_url) {
					avatar.src = user.avatar_url;
					avatar.hidden = false;
					fallback.hidden = true;
				} else {
					avatar.hidden = true;
					fallback.hidden = false;
					fallback.textContent = name.slice(0, 1).toUpperCase();
				}
			}

			// 管理中心只对管理员显示；/admin/ 本身有服务端鉴权，这里只控制入口
			const adminBlock = this.#q("admin-block");
			if (adminBlock) adminBlock.hidden = user.role !== "admin";
		}

		async #refresh(): Promise<void> {
			const r = await this.#call<MeResponse>("/api/auth/me", { method: "GET" });
			if (r.status === 200 && r.data.authenticated) {
				this.#showLogged(r.data);
				return;
			}
			this.#showGuest(
				r.data.error === "account_suspended" ? "账号已被停用" : "",
			);
		}

		#cooldown(seconds: number): void {
			const btn = this.#q<HTMLButtonElement>("send");
			if (!btn) return;
			if (this.#timer !== null) {
				window.clearInterval(this.#timer);
				this.#timer = null;
			}
			let left = seconds;
			btn.disabled = true;
			btn.textContent = `重新发送 (${left}s)`;
			this.#timer = window.setInterval(() => {
				left -= 1;
				if (left <= 0) {
					if (this.#timer !== null) window.clearInterval(this.#timer);
					this.#timer = null;
					btn.disabled = false;
					btn.textContent = "重新发送";
					return;
				}
				btn.textContent = `重新发送 (${left}s)`;
			}, 1000);
		}

		async #send(): Promise<void> {
			const emailInput = this.#q<HTMLInputElement>("email");
			const email = emailInput?.value.trim() ?? "";
			if (!email) {
				this.#say("msg", "先填邮箱", "error");
				return;
			}
			this.#say("msg", "发送中…", "");
			const r = await this.#call<CodeResponse>("/api/auth/email-code", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ email }),
			});

			if (!r.ok) {
				let hint = r.data.message || "发送失败";
				if (r.status === 429 && r.data.retry_after) {
					hint += `（${r.data.retry_after} 秒后可重试）`;
				}
				this.#say("msg", hint, "error");
				return;
			}

			const block = this.#q("code-block");
			if (block) block.hidden = false;
			const codeInput = this.#q<HTMLInputElement>("code");
			codeInput?.focus();

			if (r.data.debug_code && codeInput) {
				codeInput.value = r.data.debug_code;
				this.#say(
					"msg",
					`本地调试模式，验证码已自动填入：${r.data.debug_code}`,
					"ok",
				);
			} else {
				this.#say("msg", "验证码已发送，10 分钟内有效", "ok");
			}

			this.#cooldown(r.data.resend_after ?? 60);
		}

		async #verify(): Promise<void> {
			const emailInput = this.#q<HTMLInputElement>("email");
			const codeInput = this.#q<HTMLInputElement>("code");
			const email = emailInput?.value.trim() ?? "";
			const code = codeInput?.value.trim() ?? "";

			if (!/^\d{6}$/.test(code)) {
				this.#say("msg", "验证码是 6 位数字", "error");
				return;
			}
			this.#say("msg", "登录中…", "");
			const r = await this.#call<VerifyResponse>("/api/auth/verify", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ email, code }),
			});

			if (!r.ok) {
				let hint = r.data.message || "登录失败";
				if (r.data.error === "code_mismatch") {
					hint = `验证码不对，还可以试 ${r.data.remaining ?? 0} 次`;
				} else if (r.status === 429 && r.data.retry_after) {
					hint += `（${r.data.retry_after} 秒后可重试）`;
				}
				this.#say("msg", hint, "error");
				return;
			}

			this.#say("msg", "", "");
			if (codeInput) codeInput.value = "";
			const block = this.#q("code-block");
			if (block) block.hidden = true;
			await this.#refresh();
		}

		async #logout(): Promise<void> {
			const r = await this.#call("/api/auth/logout", {
				method: "POST",
				headers: { "content-type": "application/json" },
			});
			if (!r.ok) {
				this.#say("me-msg", "退出失败，请重试", "error");
				return;
			}
			this.#say("me-msg", "", "");
			await this.#refresh();
		}
	}

	if (!customElements.get("account-center")) {
		customElements.define("account-center", AccountCenter);
	}
</script>
