---
/**
 * 账号设置：头像、昵称、简介，以及修改密码。
 *
 * 登录名与 uid 只读——登录名是登录凭据（唯一索引 + 找回密码都靠它），
 * 改起来牵一发动全身，留给管理员在用户管理里处理。邮箱要改得先验证新地址，
 * 那是另一条流程，这里只展示当前值。
 *
 * 改密码原本在个人中心那张卡里，跟「改资料」隔着一个页面，改一次要来回跳。
 * 现在合并到这一页：同一个表单页里改完资料接着改密码。
 *
 * 和 AccountCenter 一样：静态页拿不到登录态，表单与提示都由 <profile-editor>
 * 的脚本按 /api/auth/me 的结果切换。
 */
import { Icon } from "astro-icon/components";
import { url } from "@/utils/url-utils";

const inputClass =
	"w-full px-4 py-2.5 rounded-xl border border-(--line-divider) bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 dark:placeholder-neutral-500 focus:border-(--primary) focus:ring-1 focus:ring-(--primary) outline-none transition-all duration-200 text-sm";
const primaryBtnClass =
	"h-10 rounded-xl bg-(--primary) px-5 text-sm font-semibold text-white transition-opacity duration-150 hover:opacity-90 active:opacity-80 disabled:pointer-events-none disabled:opacity-60 dark:text-black/70";
const labelClass = "mb-1.5 block text-xs font-medium text-75";
---

<profile-editor class="block w-full">
	<div class="flex w-full flex-col items-center">
		<section
			data-role="guest"
			hidden
			class="card-base w-full max-w-[28rem] px-6 py-8 text-center md:px-8"
		>
			<Icon
				name="material-symbols:lock-outline"
				class="mx-auto text-2xl text-(--primary)"
			/>
			<h2 class="mt-3 text-lg font-bold text-90">登录后才能改资料和密码</h2>
			<p class="mt-1.5 text-xs text-50">资料与密码属于账号本身，先登录再改。</p>
			<a
				data-role="login"
				href={url("/login/?next=/me/profile/")}
				class="mt-5 inline-flex h-10 items-center justify-center rounded-xl bg-(--primary) px-6 text-sm font-semibold text-white transition-opacity duration-150 hover:opacity-90 dark:text-black/70"
			>
				去登录
			</a>
		</section>

		<section
			data-role="form"
			hidden
			class="card-base w-full max-w-[42rem] px-6 py-7 md:px-8"
		>
			<header class="flex items-start justify-between gap-4">
				<div class="min-w-0">
					<h1 class="text-xl font-bold text-90">账号设置</h1>
					<p class="mt-1 text-xs leading-relaxed text-50">
						头像、昵称与简介会出现在评论、投稿等公共位置，连同密码一起在这里改。
					</p>
				</div>
				<a
					href={url("/me/")}
					class="shrink-0 text-xs text-50 transition-colors duration-150 hover:text-90"
				>
					返回个人中心
				</a>
			</header>

			<form data-role="profile-form" novalidate class="mt-6 space-y-5">
				<div class="flex items-start gap-4">
					<div
						data-role="avatar-box"
						class="relative flex h-16 w-16 shrink-0 items-center justify-center overflow-hidden rounded-full bg-(--btn-regular-bg) text-xl font-semibold text-(--btn-content)"
					>
						<span data-role="avatar-fallback"></span>
						<!-- 首字垫在底下：图片没加载完或加载失败时不会只剩一个空圆 -->
						<img
							data-role="avatar-preview"
							alt=""
							class="absolute inset-0 h-full w-full object-cover"
							hidden
						/>
					</div>
					<div class="min-w-0 flex-1">
						<label class={labelClass} for="pe-avatar">头像链接</label>
						<input
							id="pe-avatar"
							data-role="avatar"
							type="text"
							inputmode="url"
							autocomplete="off"
							class={inputClass}
							placeholder="https://… 或 /assets/images/avatar.png"
						/>
						<p class="mt-1.5 text-[11px] leading-relaxed text-50">
							支持 https 图片链接；站内图片填以 / 开头的路径。留空则用昵称首字。
						</p>
					</div>
				</div>

				<div>
					<label class={labelClass} for="pe-name">昵称</label>
					<input
						id="pe-name"
						data-role="name"
						type="text"
						maxlength="32"
						autocomplete="nickname"
						class={inputClass}
						placeholder="显示在评论与文章署名处"
					/>
				</div>

				<div>
					<label class={labelClass} for="pe-bio">简介</label>
					<textarea
						id="pe-bio"
						data-role="bio"
						rows="3"
						maxlength="200"
						class:list={[inputClass, "resize-y"]}
						placeholder="一句话介绍自己，可留空"></textarea>
				</div>

				<dl
					class="divide-y divide-(--line-divider) rounded-xl border border-(--line-divider) px-4 text-sm"
				>
					<div
						class="flex items-center justify-between gap-3 py-2.5"
					>
						<dt class="shrink-0 text-50">登录名</dt>
						<dd data-role="account" class="truncate text-90"></dd>
					</div>
					<div class="flex items-center justify-between gap-3 py-2.5">
						<dt class="shrink-0 text-50">邮箱</dt>
						<dd class="flex min-w-0 items-center gap-2 text-90">
							<span data-role="email" class="truncate"></span>
							<span
								data-role="verified"
								hidden
								class="shrink-0 rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-[11px] text-(--btn-content)"
								>已验证</span
							>
							<span
								data-role="unverified"
								hidden
								class="shrink-0 rounded-full bg-(--btn-regular-bg) px-2 py-0.5 text-[11px] text-(--accent-text)"
								>未验证</span
							>
						</dd>
					</div>
					<div class="flex items-center justify-between gap-3 py-2.5">
						<dt class="shrink-0 text-50">UID</dt>
						<dd
							data-role="uid"
							class="truncate tabular-nums text-90"
						></dd>
					</div>
				</dl>
				<p class="-mt-2 text-[11px] leading-relaxed text-50">
					登录名与邮箱不在这里改：登录名是登录凭据，换邮箱需要先验证新地址。
				</p>

				<div class="flex flex-wrap items-center gap-3">
					<button data-role="save" type="submit" class={primaryBtnClass}>
						保存资料
					</button>
				</div>

				<div
					data-role="msg"
					class="auth-status"
					role="status"
					aria-live="polite"
					hidden
				>
				</div>
			</form>

			<div class="my-7 h-px bg-(--line-divider)" role="separator"></div>

			<section>
				<div class="flex items-center gap-2">
					<Icon
						name="material-symbols:lock-outline"
						class="text-base text-(--primary)"
					/>
					<h2 class="text-sm font-semibold text-90">修改密码</h2>
				</div>
				<p class="mt-1 text-[11px] leading-relaxed text-50">
					改完会踢掉其它设备上的登录，当前浏览器自动续上。
				</p>

				<form data-role="pw-form" novalidate class="mt-4 space-y-4">
					<div>
						<label class={labelClass} for="pe-pw-current">当前密码</label>
						<input
							id="pe-pw-current"
							data-role="pw-current"
							type="password"
							autocomplete="current-password"
							class={inputClass}
							placeholder="用 GitHub 登录、从未设过密码的可留空"
						/>
					</div>
					<div>
						<label class={labelClass} for="pe-pw-new">新密码</label>
						<input
							id="pe-pw-new"
							data-role="pw-new"
							type="password"
							autocomplete="new-password"
							class={inputClass}
							placeholder="至少 8 位，同时含字母和数字"
						/>
					</div>
					<div>
						<label class={labelClass} for="pe-pw-confirm">确认新密码</label>
						<input
							id="pe-pw-confirm"
							data-role="pw-confirm"
							type="password"
							autocomplete="new-password"
							class={inputClass}
							placeholder="再输一遍，避免手滑设成别的"
						/>
					</div>

					<div class="flex flex-wrap items-center gap-3">
						<button
							data-role="pw-save"
							type="submit"
							class="btn-regular h-10 rounded-xl px-5 text-sm font-medium disabled:pointer-events-none disabled:opacity-60"
						>
							更新密码
						</button>
					</div>

					<div
						data-role="pw-msg"
						class="auth-status"
						role="status"
						aria-live="polite"
						hidden
					>
					</div>
				</form>
			</section>
		</section>
	</div>
</profile-editor>

<style>
	[hidden] {
		display: none !important;
	}
</style>

<script>
	import {
		type ApiResult,
		failureText,
		passwordHint,
		postJson,
		request,
		say,
		setBusy,
	} from "./auth-client";

	interface ProfileUser {
		uid: number;
		account: string;
		email: string;
		role: string;
		display_name: string;
		avatar_url: string | null;
		bio: string | null;
		email_verified: number;
	}

	interface MeResponse {
		authenticated: boolean;
		user?: ProfileUser;
		error?: string;
		message?: string;
	}

	interface ProfileResponse {
		ok?: boolean;
		user?: ProfileUser;
		error?: string;
		message?: string;
	}

	class ProfileEditor extends HTMLElement {
		private guest!: HTMLElement;
		private form!: HTMLElement;
		/** 资料表单单独存：卡片容器也是 data-role="form"，绑在容器上会把密码表单的 submit 一起收 */
		private profileForm!: HTMLFormElement;
		private inputAvatar!: HTMLInputElement;
		private inputName!: HTMLInputElement;
		private inputBio!: HTMLTextAreaElement;
		private preview!: HTMLImageElement;
		private fallback!: HTMLElement;
		private msg!: HTMLElement;
		private saveBtn!: HTMLButtonElement;
		private pwForm!: HTMLFormElement;
		private pwCurrent!: HTMLInputElement;
		private pwNew!: HTMLInputElement;
		private pwConfirm!: HTMLInputElement;
		private pwMsg!: HTMLElement;
		private pwSaveBtn!: HTMLButtonElement;

		connectedCallback(): void {
			this.guest = this.querySelector('[data-role="guest"]') as HTMLElement;
			this.form = this.querySelector('[data-role="form"]') as HTMLElement;
			this.profileForm = this.querySelector(
				'[data-role="profile-form"]',
			) as HTMLFormElement;
			this.inputAvatar = this.querySelector(
				'[data-role="avatar"]',
			) as HTMLInputElement;
			this.inputName = this.querySelector(
				'[data-role="name"]',
			) as HTMLInputElement;
			this.inputBio = this.querySelector(
				'[data-role="bio"]',
			) as HTMLTextAreaElement;
			this.preview = this.querySelector(
				'[data-role="avatar-preview"]',
			) as HTMLImageElement;
			this.fallback = this.querySelector(
				'[data-role="avatar-fallback"]',
			) as HTMLElement;
			this.msg = this.querySelector('[data-role="msg"]') as HTMLElement;
			this.saveBtn = this.querySelector(
				'[data-role="save"]',
			) as HTMLButtonElement;
			this.pwForm = this.querySelector(
				'[data-role="pw-form"]',
			) as HTMLFormElement;
			this.pwCurrent = this.querySelector(
				'[data-role="pw-current"]',
			) as HTMLInputElement;
			this.pwNew = this.querySelector(
				'[data-role="pw-new"]',
			) as HTMLInputElement;
			this.pwConfirm = this.querySelector(
				'[data-role="pw-confirm"]',
			) as HTMLInputElement;
			this.pwMsg = this.querySelector('[data-role="pw-msg"]') as HTMLElement;
			this.pwSaveBtn = this.querySelector(
				'[data-role="pw-save"]',
			) as HTMLButtonElement;

			this.preview?.addEventListener("error", () => {
				// 地址写错或图挂了：收起图片，露出底下的首字
				this.preview.hidden = true;
			});
			this.inputAvatar?.addEventListener("input", () => {
				this.paintAvatar(this.inputAvatar.value.trim() || null);
			});
			this.inputName?.addEventListener("input", () => {
				this.fallback.textContent = (this.inputName.value.trim() || "?").slice(
					0,
					1,
				);
			});
			this.profileForm?.addEventListener("submit", (event) => {
				event.preventDefault();
				void this.save();
			});
			this.pwForm?.addEventListener("submit", (event) => {
				event.preventDefault();
				void this.changePassword();
			});

			void this.load();
		}

		private async load(): Promise<void> {
			const result = await request<MeResponse>("/api/auth/me");
			const user = result.data?.user;
			if (!result.ok || !user) {
				this.guest.hidden = false;
				this.form.hidden = true;
				return;
			}
			this.guest.hidden = true;
			this.form.hidden = false;

			this.inputName.value = user.display_name ?? "";
			this.inputAvatar.value = user.avatar_url ?? "";
			this.inputBio.value = user.bio ?? "";
			this.paintAvatar(user.avatar_url);

			this.setText("account", user.account);
			this.setText("email", user.email);
			this.setText("uid", String(user.uid));
			const verified = this.querySelector<HTMLElement>(
				'[data-role="verified"]',
			);
			const unverified = this.querySelector<HTMLElement>(
				'[data-role="unverified"]',
			);
			if (verified) verified.hidden = !user.email_verified;
			if (unverified) unverified.hidden = Boolean(user.email_verified);
		}

		private setText(role: string, value: string): void {
			const el = this.querySelector(`[data-role="${role}"]`);
			if (el) el.textContent = value;
		}

		/**
		 * 头像预览：首字一直垫在底下，图片加载成功才盖上去。
		 * 加载中/失败都只是「看起来还没换」，不会变成一个空圆。
		 */
		private paintAvatar(src: string | null): void {
			this.fallback.textContent = (this.inputName?.value.trim() || "?").slice(
				0,
				1,
			);
			if (src) {
				this.preview.src = src;
				this.preview.hidden = false;
			} else {
				this.preview.hidden = true;
				this.preview.removeAttribute("src");
			}
		}

		private async save(): Promise<void> {
			const name = this.inputName.value.trim();
			if (!name) {
				say(this.msg, "昵称不能为空", "error");
				this.inputName.focus();
				return;
			}

			setBusy(this.saveBtn, true, "保存中…");
			say(this.msg, "", "");
			const result: ApiResult<ProfileResponse> = await request<ProfileResponse>(
				"/api/me/profile",
				{
					method: "PATCH",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({
						display_name: name,
						avatar_url: this.inputAvatar.value.trim(),
						bio: this.inputBio.value,
					}),
				},
			);
			setBusy(this.saveBtn, false);

			if (!result.ok || !result.data?.user) {
				const message =
					result.data?.message ??
					(result.malformed || result.unreachable
						? failureText(result)
						: "保存失败，稍后重试");
				say(this.msg, message, "error");
				return;
			}

			const user = result.data.user;
			this.inputName.value = user.display_name;
			this.inputAvatar.value = user.avatar_url ?? "";
			this.inputBio.value = user.bio ?? "";
			this.paintAvatar(user.avatar_url);
			say(this.msg, "资料已保存", "ok");
		}

		/**
		 * 改密码。接口只认「当前密码 + 新密码」，确认框是页面自己加的：
		 * 新密码打错一个字符，下次登录就进不去了。
		 */
		private async changePassword(): Promise<void> {
			const current = this.pwCurrent?.value ?? "";
			const next = this.pwNew?.value ?? "";
			const confirm = this.pwConfirm?.value ?? "";

			const hint = passwordHint(next);
			if (hint) {
				say(this.pwMsg, hint, "error");
				this.pwNew?.focus();
				return;
			}
			if (next !== confirm) {
				say(this.pwMsg, "两次输入的新密码不一致", "error");
				this.pwConfirm?.focus();
				return;
			}
			if (current && next === current) {
				say(this.pwMsg, "新密码与当前密码相同", "error");
				this.pwNew?.focus();
				return;
			}

			setBusy(this.pwSaveBtn, true, "更新中…");
			say(this.pwMsg, "", "");
			const result = await postJson<{
				ok?: boolean;
				error?: string;
				message?: string;
			}>("/api/auth/password", {
				current_password: current,
				password: next,
			});
			setBusy(this.pwSaveBtn, false);

			if (!result.ok) {
				const message =
					result.data?.message ??
					(result.malformed || result.unreachable
						? failureText(result)
						: "改密失败，稍后重试");
				say(this.pwMsg, message, "error");
				return;
			}

			if (this.pwCurrent) this.pwCurrent.value = "";
			if (this.pwNew) this.pwNew.value = "";
			if (this.pwConfirm) this.pwConfirm.value = "";
			say(this.pwMsg, "密码已更新，其它设备需要重新登录", "ok");
		}
	}

	if (!customElements.get("profile-editor")) {
		customElements.define("profile-editor", ProfileEditor);
	}
</script>
