---
import AuthPanel from "@/components/user/AuthPanel.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "设置新密码";
const description = "设置 Yuki Blog 账号的新密码。";
---

<MainGridLayout title={title} description={description}>
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<meta slot="head" name="referrer" content="no-referrer" />
	<AuthPanel mode="reset" />
</MainGridLayout>
