---
import AuthPanel from "@/components/user/AuthPanel.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "找回密码";
const description = "用注册邮箱收一条重置链接，1 小时内有效。";
---

<MainGridLayout title={title} description={description}>
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<AuthPanel mode="forgot" />
</MainGridLayout>
