---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSeriesList } from "@/utils/content-utils";
import { getPostUrlBySlug } from "@/utils/url-utils";

const seriesList = await getSeriesList();
const totalPosts = seriesList.reduce((sum, series) => sum + series.count, 0);

/**
 * 没有封面时的兜底色相：同一个系列名永远同一个颜色，换页面不会跳。
 * 只用它淡铺在底上，真正读的是右下角那个首字。
 */
function hueOf(name: string): number {
	let hash = 0;
	for (let i = 0; i < name.length; i += 1) {
		hash = (hash * 31 + name.charCodeAt(i)) % 360;
	}
	return hash;
}
---

<MainGridLayout title={i18n(I18nKey.series)} description={i18n(I18nKey.allSeries)}>
    <!-- 页面标题 -->
    <div class="card-base px-8 py-6 mb-4">
        <div class="text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.series)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allSeries)} · {totalPosts} {i18n(I18nKey.postsCount)}
        </p>
    </div>

    <!-- 系列列表：手风琴卡片（默认收起） -->
    {
        seriesList.length > 0 ? (
            <div class="grid grid-cols-[repeat(auto-fit,minmax(20rem,1fr))] items-start gap-4 mb-4">
                {
                    seriesList.map((series) => (
                        <div class="series-acc card-base overflow-hidden">
                            {series.layout === "banner" && (
                                <div
                                    class:list={[
                                        "series-banner",
                                        { "is-blank": !series.cover },
                                    ]}
                                    style={`--h:${hueOf(series.name)}`}
                                    aria-hidden="true"
                                >
                                    {series.cover ? (
                                        <img
                                            src={series.cover}
                                            alt=""
                                            loading="lazy"
                                            decoding="async"
                                        />
                                    ) : (
                                        <span class="series-banner-mark">
                                            {series.name.slice(0, 1)}
                                        </span>
                                    )}
                                </div>
                            )}
                            <button
                                type="button"
                                aria-expanded="false"
                                class:list={[
                                    "series-acc-header group flex w-full items-center gap-3 cursor-pointer select-none text-left transition",
                                    // 内边距只能在两套里选一套：同时出现 p-5 与 px-5 时由 CSS 顺序决定，
                                    // 横幅形态上方的留白会时大时小
                                    series.layout === "banner"
                                        ? "px-5 md:px-6 pt-4 pb-3"
                                        : "p-5 md:p-6 pb-3",
                                ]}
                            >
                                {series.layout !== "banner" && (
                                    <span class="series-badge">
                                        {series.layout === "icon" && series.cover ? (
                                            <img
                                                src={series.cover}
                                                alt=""
                                                loading="lazy"
                                                decoding="async"
                                            />
                                        ) : (
                                            <Icon
                                                name="material-symbols:layers"
                                                aria-hidden="true"
                                                class="text-2xl text-(--primary)"
                                            />
                                        )}
                                    </span>
                                )}
                                <span class="flex-1 min-w-0">
                                    <span class="block text-lg font-bold text-90 truncate group-hover:text-(--primary) transition">
                                        {series.name}
                                    </span>
                                    <span class="block text-sm text-30 mt-0.5 transition group-hover:text-(--primary)/60">
                                        {series.count} {i18n(I18nKey.postsCount)}
                                    </span>
                                    {series.description && (
                                        <span class="series-desc text-50 group-hover:text-(--primary)/70">
                                            {series.description}
                                        </span>
                                    )}
                                </span>
                                <Icon
                                    name="material-symbols:keyboard-arrow-down-rounded"
                                    aria-hidden="true"
                                    class="acc-arrow shrink-0 text-[1.25rem] text-30 group-hover:text-(--primary) transition-transform duration-300"
                                />
                            </button>

                            <div class="series-acc-content overflow-hidden max-h-0 transition-[max-height,opacity] duration-300 ease-in-out">
                                <ol class="flex flex-col px-5 md:px-6 pb-4">
                                    {
                                        series.posts.map((post, idx) => (
                                            <li>
                                                <a
                                                    href={getPostUrlBySlug(post.id)}
                                                    class:list={[
                                                        "group flex items-center gap-3 px-3 py-3 -mx-1 rounded-lg transition-all",
                                                        "hover:bg-black/5 dark:hover:bg-white/5 active:scale-[0.98]",
                                                        idx < series.posts.length - 1 &&
                                                            "border-b border-dashed border-(--line-divider)",
                                                    ]}
                                                >
                                                    <span class="shrink-0 w-6 h-6 rounded-md bg-(--enter-btn-bg) text-(--primary) flex items-center justify-center text-sm font-bold transition">
                                                        {idx + 1}
                                                    </span>
                                                    <span class="flex-1 min-w-0 font-bold text-sm text-black/75 dark:text-white/75 truncate transition group-hover:text-(--primary)">
                                                        {post.data.title}
                                                    </span>
                                                    <Icon
                                                        name="material-symbols:chevron-right-rounded"
                                                        aria-hidden="true"
                                                        class="shrink-0 text-xl text-black/15 dark:text-white/15 transition group-hover:text-(--primary) group-hover:translate-x-0.5"
                                                    />
                                                </a>
                                            </li>
                                        ))
                                    }
                                </ol>
                            </div>
                        </div>
                    ))
                }
            </div>
        ) : (
            <div class="card-base px-8 py-12 text-center">
                <Icon name="material-symbols:layers" class="text-5xl text-30 mx-auto mb-4" />
                <p class="text-30">{i18n(I18nKey.noSeries)}</p>
            </div>
        )
    }

    <script is:inline>
        function onSeriesAccordion(e) {
            var btn = e.target && e.target.closest ? e.target.closest('.series-acc-header') : null;
            if (!btn) return;
            var card = btn.closest('.series-acc');
            var content = card ? card.querySelector('.series-acc-content') : null;
            if (!content) return;

            var isOpen = btn.getAttribute('aria-expanded') === 'true';

            // 手风琴：关闭其它已展开的系列
            var others = document.querySelectorAll('.series-acc-header[aria-expanded="true"]');
            for (var i = 0; i < others.length; i++) {
                var o = others[i];
                if (o === btn) continue;
                o.setAttribute('aria-expanded', 'false');
                var oc = o.closest('.series-acc');
                var ocC = oc ? oc.querySelector('.series-acc-content') : null;
                if (ocC) {
                    ocC.setAttribute('data-open', 'false');
                    ocC.style.maxHeight = '0px';
                }
            }

            var next = !isOpen;
            btn.setAttribute('aria-expanded', String(next));
            content.setAttribute('data-open', String(next));
            content.style.maxHeight = next ? content.scrollHeight + 'px' : '0px';
        }

        // 事件委托，Swup 切页后新内容也能工作；避免重复注册（@swup/scripts-plugin 会重跑内联脚本）
        if (!window.__seriesAccordionInit) {
            window.__seriesAccordionInit = true;
            document.addEventListener('click', onSeriesAccordion);
        }
    </script>
</MainGridLayout>

<style>
    .series-acc-header[aria-expanded="true"] .acc-arrow {
        transform: rotate(180deg);
    }
    .series-acc-content {
        opacity: 0;
    }
    .series-acc-content[data-open="true"] {
        opacity: 1;
    }

    /* 横幅封面：卡宽、2.4:1，跟文章卡的封面比例一致 */
    .series-banner {
        position: relative;
        aspect-ratio: 2.4 / 1;
        display: grid;
        place-items: center;
        overflow: hidden;
        /* 没人配图时的底：主题色相淡铺一层，不写死颜色 */
        background: linear-gradient(
            135deg,
            color-mix(in oklab, hsl(var(--h) 62% 52%) 16%, var(--card-bg)),
            color-mix(in oklab, hsl(calc(var(--h) + 26) 58% 48%) 7%, var(--card-bg))
        );
    }

    /* 纯色块太像没加载出来的占位：左上压一层柔光，右下角留首字。
       斜纹试过，在 2.4:1 的宽幅里会读成条纹纸，不如一层径向光干净 */
    .series-banner.is-blank::after {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(
            90% 120% at 6% -12%,
            hsl(var(--h) 62% 60% / 26%),
            transparent 62%
        );
        pointer-events: none;
    }

    .series-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    /* 首字压在右下角、只留两成不透明度：它是装饰，不是要读的字。
       别用负的 bottom 把它探出卡片——卡片是 overflow:hidden，下缘会被裁掉半截 */
    .series-banner-mark {
        position: absolute;
        right: 1.1rem;
        bottom: 0.5rem;
        font-size: clamp(2.9rem, 7vw, 4.4rem);
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        color: hsl(var(--h) 44% 38%);
        opacity: 0.22;
        user-select: none;
    }

    :global(html.dark) .series-banner-mark {
        color: hsl(var(--h) 58% 74%);
        opacity: 0.34;
    }

    /* 圆形缩略图与原来的图标位同尺寸，换图不会让卡片高度变 */
    .series-badge {
        flex: none;
        display: inline-grid;
        place-items: center;
        width: 3rem;
        height: 3rem;
        border-radius: 999px;
        overflow: hidden;
        background: color-mix(in oklab, var(--primary) 10%, transparent);
        transition: background-color 0.2s ease;
    }

    .series-acc-header:hover .series-badge {
        background: color-mix(in oklab, var(--primary) 20%, transparent);
    }

    .series-badge img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .series-desc {
        display: block;
        margin-top: 0.15rem;
        font-size: 0.78rem;
        line-height: 1.45;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 0.2s ease;
    }
</style>
