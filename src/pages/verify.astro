---
import AuthPanel from "@/components/user/AuthPanel.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "验证邮箱";
const description = "验证注册邮箱，完成账号激活。";
---

<MainGridLayout title={title} description={description}>
	<meta slot="head" name="robots" content="noindex, nofollow" />
	<meta slot="head" name="referrer" content="no-referrer" />
	<AuthPanel mode="verify" />
</MainGridLayout>
